# JSON object mapping redeem codes to rewards.
# Keep this value SERVER-SIDE in Vercel. Do not put it in the Unity project.
#
# Example:
# REDEEM_CODES={"welcome2026":{"cosmetics":["cosmetic_hat_01"],"message":"WELCOME!","active":true},"gold2026":{"cosmetics":["gold_badge"],"active":true,"expiresAt":"2026-12-31T23:59:59.000Z"}}

REDEEM_CODES={"welcome2026":{"cosmetics":["cosmetic_hat_01"],"message":"WELCOME!","active":true}}
